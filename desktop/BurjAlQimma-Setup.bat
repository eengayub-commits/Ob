@echo off
title Burj Al-Qimma - Install
echo Installing Burj Al-Qimma client files shortcut...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText('%~f0',[Text.Encoding]::UTF8); $i=$s.LastIndexOf('#PS'+'START'); Invoke-Expression $s.Substring($i)"
echo.
pause
exit /b
#PSSTART
$ErrorActionPreference = 'Stop'
$url  = 'https://claude.ai/artifact/8pPqkAZnHNmzy1BYjzitAx'
$name = 'برج القمة - ملفات العملاء'
$dir  = Join-Path $env:LOCALAPPDATA 'BurjAlQimma'
New-Item -ItemType Directory -Force -Path $dir | Out-Null
$ico = Join-Path $dir 'icon.ico'
[IO.File]::WriteAllBytes($ico, [Convert]::FromBase64String(''))

$candidates = @(
  "${env:ProgramFiles(x86)}\Microsoft\Edge\Application\msedge.exe",
  "$env:ProgramFiles\Microsoft\Edge\Application\msedge.exe",
  "$env:LOCALAPPDATA\Microsoft\Edge\Application\msedge.exe",
  "$env:ProgramFiles\Google\Chrome\Application\chrome.exe",
  "${env:ProgramFiles(x86)}\Google\Chrome\Application\chrome.exe",
  "$env:LOCALAPPDATA\Google\Chrome\Application\chrome.exe"
)
$browser = $candidates | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1

$shell = New-Object -ComObject WScript.Shell
$targets = @(
  [Environment]::GetFolderPath('Desktop'),
  [Environment]::GetFolderPath('Programs')
)
foreach ($t in $targets) {
  $lnk = $shell.CreateShortcut((Join-Path $t ($name + '.lnk')))
  if ($browser) {
    $lnk.TargetPath = $browser
    $lnk.Arguments  = "--app=$url"
  } else {
    $lnk.TargetPath = "$env:WINDIR\explorer.exe"
    $lnk.Arguments  = $url
  }
  $lnk.IconLocation = "$ico,0"
  $lnk.Description  = 'Burj Al-Qimma - client files'
  $lnk.Save()
}

Write-Host ''
Write-Host 'Done. The icon is on your Desktop and in the Start menu.' -ForegroundColor Green
if (-not $browser) { Write-Host 'Edge/Chrome not found: the shortcut opens in your default browser.' -ForegroundColor Yellow }
Write-Host 'Opening the program now. Sign in to claude.ai the first time.'
if ($browser) { Start-Process $browser "--app=$url" } else { Start-Process $url }
